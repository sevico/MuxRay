{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "desktop-diagnostic-snapshot-v1.schema.json",
  "title": "MuxRay bounded desktop diagnostic snapshot v1",
  "description": "Independent of CLI reports. At most 2 MiB UTF-8 including a trailing newline. Coordinates and request identities use canonical decimal strings. May contain AMF text and at most 4 KiB retained source bytes. Trend issues are local display observations. The capture checks an existing source-change latch without restatting or reading the source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentType",
    "fileName",
    "createdAt",
    "producer",
    "scope",
    "session",
    "selection",
    "scanDiagnostics",
    "selectedTag",
    "detail",
    "hex",
    "summary",
    "summaryPage",
    "trend",
    "trendIssues",
    "omitted"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "documentType": {
      "const": "desktopDiagnosticSnapshot"
    },
    "fileName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768,
      "pattern": "^[^/\\\\]+$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,9})?Z$",
      "maxLength": 30
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "MuxRay"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sourceValidation",
        "scanDiagnostics",
        "summary",
        "trend",
        "trendInterpretation"
      ],
      "properties": {
        "kind": {
          "const": "bounded_desktop_snapshot"
        },
        "sourceValidation": {
          "const": "existing_change_latch_only"
        },
        "scanDiagnostics": {
          "const": "first_100_retained"
        },
        "summary": {
          "const": "ready_overview_and_requested_event_page"
        },
        "trend": {
          "const": "requested_source_order_window"
        },
        "trendInterpretation": {
          "const": "local_display_rule_not_parser_diagnostic"
        }
      }
    },
    "session": {
      "$ref": "#/$defs/session"
    },
    "selection": {
      "$ref": "#/$defs/selection"
    },
    "scanDiagnostics": {
      "$ref": "#/$defs/diagnosticPage"
    },
    "selectedTag": {
      "anyOf": [
        {
          "$ref": "#/$defs/tag"
        },
        {
          "type": "null"
        }
      ]
    },
    "detail": {
      "anyOf": [
        {
          "$ref": "#/$defs/detailResponse"
        },
        {
          "type": "null"
        }
      ]
    },
    "hex": {
      "anyOf": [
        {
          "$ref": "#/$defs/hexResponse"
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/summaryResponse"
        },
        {
          "type": "null"
        }
      ]
    },
    "summaryPage": {
      "anyOf": [
        {
          "$ref": "#/$defs/summaryPageResponse"
        },
        {
          "type": "null"
        }
      ]
    },
    "trend": {
      "anyOf": [
        {
          "$ref": "#/$defs/trendPage"
        },
        {
          "type": "null"
        }
      ]
    },
    "trendIssues": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/trendIssue"
      }
    },
    "omitted": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/omission"
      }
    }
  },
  "$defs": {
    "u64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$",
      "maxLength": 20
    },
    "requestId": {
      "type": "string",
      "pattern": "^([1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$",
      "maxLength": 20
    },
    "dts": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4]|4294967295)$",
      "maxLength": 10
    },
    "delta": {
      "type": "string",
      "pattern": "^(0|-?([1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4]|4294967295))$",
      "maxLength": 11
    },
    "sessionId": {
      "type": "string",
      "pattern": "^scan-[1-9][0-9]*$",
      "maxLength": 25
    },
    "fault": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byteOffset",
        "bitOffset",
        "bitLength"
      ],
      "properties": {
        "byteOffset": {
          "$ref": "#/$defs/u64"
        },
        "bitOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "bitLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "offset",
        "bitOffset",
        "message",
        "expected",
        "actual"
      ],
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 128
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "offset": {
          "$ref": "#/$defs/u64"
        },
        "bitOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "message": {
          "type": "string",
          "maxLength": 4096
        },
        "expected": {
          "anyOf": [
            {
              "$ref": "#/$defs/u64"
            },
            {
              "type": "null"
            }
          ]
        },
        "actual": {
          "anyOf": [
            {
              "$ref": "#/$defs/u64"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "summaryKind": {
      "enum": [
        "keyframes",
        "aac",
        "avc",
        "mp3",
        "diagnostics"
      ]
    },
    "trendType": {
      "enum": [
        "all",
        "audio",
        "video",
        "script",
        "other"
      ]
    },
    "trendMetric": {
      "enum": [
        "dts",
        "delta",
        "size"
      ]
    },
    "omission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section",
        "reason"
      ],
      "properties": {
        "section": {
          "enum": [
            "selectedTag",
            "detail",
            "hex",
            "summary",
            "summaryPage",
            "trend"
          ]
        },
        "reason": {
          "type": "string",
          "pattern": "^[a-z][a-z_]*$",
          "maxLength": 64
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section",
        "name",
        "value",
        "unit"
      ],
      "properties": {
        "section": {
          "type": "string",
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "value": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSize",
        "bytesScanned",
        "tagCount",
        "diagnosticCount"
      ],
      "properties": {
        "sourceSize": {
          "$ref": "#/$defs/u64"
        },
        "bytesScanned": {
          "$ref": "#/$defs/u64"
        },
        "tagCount": {
          "$ref": "#/$defs/u64"
        },
        "diagnosticCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "state",
        "terminal",
        "closed",
        "progress",
        "scan",
        "failure"
      ],
      "properties": {
        "sessionId": {
          "$ref": "#/$defs/sessionId"
        },
        "state": {
          "enum": [
            "finished",
            "canceled",
            "failed"
          ]
        },
        "terminal": {
          "const": true
        },
        "closed": {
          "const": false
        },
        "progress": {
          "$ref": "#/$defs/progress"
        },
        "scan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "complete",
            "hasErrors"
          ],
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "hasErrors": {
              "type": "boolean"
            }
          }
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/fault"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "summaryPageRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "start",
        "count"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/summaryKind"
        },
        "start": {
          "$ref": "#/$defs/u64"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "trendRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "count",
        "type",
        "metric",
        "gapThreshold"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/u64"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "type": {
          "$ref": "#/$defs/trendType"
        },
        "metric": {
          "$ref": "#/$defs/trendMetric"
        },
        "gapThreshold": {
          "type": "string",
          "pattern": "^([1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4]|4294967295)$",
          "maxLength": 10
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "selectedTagId",
        "detailRequestId",
        "hexRequestId",
        "summaryRequestId",
        "summaryPage",
        "trend"
      ],
      "properties": {
        "sessionId": {
          "$ref": "#/$defs/sessionId"
        },
        "selectedTagId": {
          "anyOf": [
            {
              "$ref": "#/$defs/u64"
            },
            {
              "type": "null"
            }
          ]
        },
        "detailRequestId": {
          "anyOf": [
            {
              "$ref": "#/$defs/requestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "hexRequestId": {
          "anyOf": [
            {
              "$ref": "#/$defs/requestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "summaryRequestId": {
          "anyOf": [
            {
              "$ref": "#/$defs/requestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "summaryPage": {
          "anyOf": [
            {
              "$ref": "#/$defs/summaryPageRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "trend": {
          "anyOf": [
            {
              "$ref": "#/$defs/trendRequest"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "tag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "typeCode",
        "typeName",
        "offset",
        "span",
        "headerSpan",
        "payloadSpan",
        "rawTypeFlags",
        "filter",
        "dataSize",
        "availableDataSize",
        "dts",
        "streamId",
        "payloadComplete",
        "previousTagSize"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/u64"
        },
        "typeCode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "typeName": {
          "enum": [
            "audio",
            "video",
            "script",
            "unknown"
          ]
        },
        "offset": {
          "$ref": "#/$defs/u64"
        },
        "span": {
          "$ref": "#/$defs/span"
        },
        "headerSpan": {
          "$ref": "#/$defs/span"
        },
        "payloadSpan": {
          "$ref": "#/$defs/span"
        },
        "rawTypeFlags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "filter": {
          "type": "boolean"
        },
        "dataSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "availableDataSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "dts": {
          "$ref": "#/$defs/dts"
        },
        "streamId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "payloadComplete": {
          "type": "boolean"
        },
        "previousTagSize": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "present",
            "span",
            "value",
            "expected",
            "valid"
          ],
          "properties": {
            "present": {
              "type": "boolean"
            },
            "span": {
              "anyOf": [
                {
                  "$ref": "#/$defs/span"
                },
                {
                  "type": "null"
                }
              ]
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "expected": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "valid": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "diagnosticPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "bounds",
        "diagnostics"
      ],
      "properties": {
        "sessionId": {
          "$ref": "#/$defs/sessionId"
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "next",
            "total",
            "limit"
          ],
          "properties": {
            "start": {
              "$ref": "#/$defs/u64"
            },
            "next": {
              "$ref": "#/$defs/u64"
            },
            "total": {
              "$ref": "#/$defs/u64"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      }
    },
    "detailField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parentId",
        "name",
        "type",
        "value",
        "span"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 256
        },
        "parentId": {
          "type": "string",
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "type": {
          "type": "string",
          "maxLength": 256
        },
        "value": {
          "type": "string",
          "maxLength": 256
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/span"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "complete",
        "truncated",
        "fields",
        "diagnostics"
      ],
      "properties": {
        "kind": {
          "enum": [
            "amf0ScriptData",
            "aacAudio",
            "avcVideo",
            "mp3Audio"
          ]
        },
        "complete": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        },
        "fields": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/detailField"
          }
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      }
    },
    "detailResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "sessionId",
        "requestId",
        "tagId",
        "state",
        "detail",
        "error"
      ],
      "properties": {
        "apiVersion": {
          "const": 1
        },
        "sessionId": {
          "$ref": "#/$defs/sessionId"
        },
        "requestId": {
          "$ref": "#/$defs/requestId"
        },
        "tagId": {
          "$ref": "#/$defs/u64"
        },
        "state": {
          "const": "ready"
        },
        "detail": {
          "$ref": "#/$defs/detail"
        },
        "error": {
          "type": "null"
        }
      }
    },
    "hexWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offset",
        "sourceSize",
        "hex",
        "eof"
      ],
      "properties": {
        "offset": {
          "$ref": "#/$defs/u64"
        },
        "sourceSize": {
          "$ref": "#/$defs/u64"
        },
        "hex": {
          "type": "string",
          "pattern": "^([0-9a-f]{2})*$",
          "maxLength": 8192
        },
        "eof": {
          "type": "boolean"
        }
      }
    },
    "hexResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "sessionId",
        "requestId",
        "offset",
        "count",
        "state",
        "window",
        "error"
      ],
      "properties": {
        "apiVersion": {
          "const": 1
        },
        "sessionId": {
          "$ref": "#/$defs/sessionId"
        },
        "requestId": {
          "$ref": "#/$defs/requestId"
        },
        "offset": {
          "$ref": "#/$defs/u64"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "state": {
          "const": "ready"
        },
        "window": {
          "$ref": "#/$defs/hexWindow"
        },
        "error": {
          "type": "null"
        }
      }
    },
    "listInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "observed",
        "retained",
        "truncated"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/summaryKind"
        },
        "observed": {
          "anyOf": [
            {
              "$ref": "#/$defs/u64"
            },
            {
              "type": "null"
            }
          ]
        },
        "retained": {
          "$ref": "#/$defs/u64"
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSize",
        "indexedTags",
        "scanComplete",
        "scanHasErrors",
