        "frameCropTopOffset": {"$ref": "#/$defs/mappedUnsignedField"},
        "frameCropBottomOffset": {"$ref": "#/$defs/mappedUnsignedField"},
        "vuiParametersPresentFlag": {"$ref": "#/$defs/mappedBooleanField"},
        "chromaArrayType": {"$ref": "#/$defs/uint32"},
