    },
    "mappedSignedField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "span"],
      "properties": {"value": {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807}, "span": {"$ref": "#/$defs/mappedSpan"}}
    },
    "mappedBooleanField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "span"],
      "properties": {"value": {"type": "boolean"}, "span": {"$ref": "#/$defs/mappedSpan"}}
