        "numRefFramesInPicOrderCntCycle": ["deltaPicOrderAlwaysZeroFlag", "offsetForNonRefPic", "offsetForTopToBottomField"],
        "frameCropRightOffset": ["frameCropLeftOffset"],
        "frameCropTopOffset": ["frameCropLeftOffset", "frameCropRightOffset"],
        "frameCropBottomOffset": ["frameCropLeftOffset", "frameCropRightOffset", "frameCropTopOffset"],
        "displayWidth": ["displayHeight", "chromaArrayType", "cropUnitX", "cropUnitY", "codedWidth", "codedHeight"],
        "displayHeight": ["displayWidth", "chromaArrayType", "cropUnitX", "cropUnitY", "codedWidth", "codedHeight"]
      },
      "allOf": [
        {"if": {"properties": {"complete": {"const": true}}, "required": ["complete"]}, "then": {"required": ["profileIdc", "constraintSetFlags", "reservedZero2Bits", "levelIdc", "sequenceParameterSetId", "log2MaxFrameNumMinus4", "picOrderCntType", "maxNumRefFrames", "gapsInFrameNumValueAllowedFlag", "picWidthInMbsMinus1", "picHeightInMapUnitsMinus1", "frameMbsOnlyFlag", "direct8x8InferenceFlag", "frameCroppingFlag", "vuiParametersPresentFlag", "chromaArrayType", "cropUnitX", "cropUnitY", "codedWidth", "codedHeight", "displayWidth", "displayHeight"]}},
        {"if": {"required": ["highProfile"]}, "then": {"required": ["profileIdc", "sequenceParameterSetId"], "properties": {"profileIdc": {"properties": {"value": {"enum": [44, 83, 86, 100, 110, 118, 122, 128, 134, 135, 138, 139, 144, 244]}}, "required": ["value"]}}}},
        {"if": {"properties": {"profileIdc": {"properties": {"value": {"enum": [44, 83, 86, 100, 110, 118, 122, 128, 134, 135, 138, 139, 144, 244]}}, "required": ["value"]}}, "required": ["profileIdc", "sequenceParameterSetId"]}, "then": {"required": ["highProfile"]}},
        {"if": {"properties": {"complete": {"const": true}, "profileIdc": {"properties": {"value": {"enum": [44, 83, 86, 100, 110, 118, 122, 128, 134, 135, 138, 139, 144, 244]}}, "required": ["value"]}}, "required": ["complete", "profileIdc"]}, "then": {"required": ["highProfile"], "properties": {"highProfile": {"required": ["chromaFormatIdc", "bitDepthLumaMinus8", "bitDepthChromaMinus8", "qpPrimeYZeroTransformBypassFlag", "sequenceScalingMatrixPresentFlag"]}}}},
        {"if": {"required": ["log2MaxPicOrderCntLsbMinus4"]}, "then": {"required": ["picOrderCntType"], "properties": {"picOrderCntType": {"properties": {"value": {"const": 0}}, "required": ["value"]}}}},
        {"if": {"anyOf": [{"required": ["deltaPicOrderAlwaysZeroFlag"]}, {"required": ["offsetForNonRefPic"]}, {"required": ["offsetForTopToBottomField"]}, {"required": ["numRefFramesInPicOrderCntCycle"]}]}, "then": {"required": ["picOrderCntType"], "properties": {"picOrderCntType": {"properties": {"value": {"const": 1}}, "required": ["value"]}}}},
        {"if": {"properties": {"picOrderCntType": {"properties": {"value": {"const": 0}}, "required": ["value"]}}, "required": ["picOrderCntType"]}, "then": {"not": {"anyOf": [{"required": ["deltaPicOrderAlwaysZeroFlag"]}, {"required": ["offsetForNonRefPic"]}, {"required": ["offsetForTopToBottomField"]}, {"required": ["numRefFramesInPicOrderCntCycle"]}]}}},
        {"if": {"properties": {"picOrderCntType": {"properties": {"value": {"const": 1}}, "required": ["value"]}}, "required": ["picOrderCntType"]}, "then": {"not": {"required": ["log2MaxPicOrderCntLsbMinus4"]}}},
        {"if": {"properties": {"picOrderCntType": {"properties": {"value": {"const": 2}}, "required": ["value"]}}, "required": ["picOrderCntType"]}, "then": {"not": {"anyOf": [{"required": ["log2MaxPicOrderCntLsbMinus4"]}, {"required": ["deltaPicOrderAlwaysZeroFlag"]}, {"required": ["offsetForNonRefPic"]}, {"required": ["offsetForTopToBottomField"]}, {"required": ["numRefFramesInPicOrderCntCycle"]}]}}},
        {"if": {"properties": {"picOrderCntType": {"properties": {"value": {"const": 0}}, "required": ["value"]}}, "required": ["picOrderCntType", "maxNumRefFrames"]}, "then": {"required": ["log2MaxPicOrderCntLsbMinus4"]}},
        {"if": {"properties": {"picOrderCntType": {"properties": {"value": {"const": 1}}, "required": ["value"]}}, "required": ["picOrderCntType", "maxNumRefFrames"]}, "then": {"required": ["deltaPicOrderAlwaysZeroFlag", "offsetForNonRefPic", "offsetForTopToBottomField", "numRefFramesInPicOrderCntCycle"]}},
        {"if": {"required": ["mbAdaptiveFrameFieldFlag"]}, "then": {"required": ["frameMbsOnlyFlag"], "properties": {"frameMbsOnlyFlag": {"properties": {"value": {"const": false}}, "required": ["value"]}}}},
        {"if": {"properties": {"frameMbsOnlyFlag": {"properties": {"value": {"const": true}}, "required": ["value"]}}, "required": ["frameMbsOnlyFlag"]}, "then": {"not": {"required": ["mbAdaptiveFrameFieldFlag"]}}},
        {"if": {"properties": {"frameMbsOnlyFlag": {"properties": {"value": {"const": false}}, "required": ["value"]}}, "required": ["frameMbsOnlyFlag", "direct8x8InferenceFlag"]}, "then": {"required": ["mbAdaptiveFrameFieldFlag"]}},
        {"if": {"properties": {"complete": {"const": true}, "frameMbsOnlyFlag": {"properties": {"value": {"const": false}}, "required": ["value"]}}, "required": ["complete", "frameMbsOnlyFlag"]}, "then": {"required": ["mbAdaptiveFrameFieldFlag"]}},
