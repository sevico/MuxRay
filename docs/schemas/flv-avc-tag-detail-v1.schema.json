        "codedWidth": {"$ref": "#/$defs/uint64", "minimum": 1},
        "codedHeight": {"$ref": "#/$defs/uint64", "minimum": 1},
        "displayWidth": {"$ref": "#/$defs/uint64", "minimum": 1},
        "displayHeight": {"$ref": "#/$defs/uint64", "minimum": 1},
        "syntaxBits": {"$ref": "#/$defs/uint32"},
        "remainingRbspBits": {"$ref": "#/$defs/uint32"},
