        "sourceSpan": {"$ref": "#/$defs/span"}
      }
    },
    "rbspView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ebspSpan", "byteLength", "sourceSegments", "emulationPreventionBytes"],
      "properties": {
        "ebspSpan": {"$ref": "#/$defs/span"},
        "byteLength": {"$ref": "#/$defs/uint32"},
        "sourceSegments": {"type": "array", "maxItems": 65536, "items": {"$ref": "#/$defs/rbspSourceSegment"}},
        "emulationPreventionBytes": {"type": "array", "maxItems": 65536, "items": {"$ref": "#/$defs/span"}}
      }
