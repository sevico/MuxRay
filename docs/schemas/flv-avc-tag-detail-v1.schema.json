      },
      "oneOf": [
        {"properties": {"value": {"const": 0}, "name": {"const": "sequenceHeader"}}},
        {"properties": {"value": {"const": 1}, "name": {"const": "nalu"}}},
        {"properties": {"value": {"const": 2}, "name": {"const": "endOfSequence"}}},
        {"properties": {"value": {"minimum": 3}, "name": {"const": "unknown"}}}
      ]
    },
    "compositionTime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "value", "span"],
      "properties": {
        "raw": {"$ref": "#/$defs/uint24"},
        "value": {"type": "integer", "minimum": -8388608, "maximum": 8388607},
        "span": {"$ref": "#/$defs/span"}
      }
    },
    "nalUnitTypeField": {
      "allOf": [
        {"$ref": "#/$defs/namedField"},
        {"oneOf": [
          {"properties": {"value": {"const": 0}, "name": {"const": "unspecified"}}},
          {"properties": {"value": {"const": 1}, "name": {"const": "nonIDRSlice"}}},
          {"properties": {"value": {"const": 2}, "name": {"const": "dataPartitionA"}}},
          {"properties": {"value": {"const": 3}, "name": {"const": "dataPartitionB"}}},
          {"properties": {"value": {"const": 4}, "name": {"const": "dataPartitionC"}}},
          {"properties": {"value": {"const": 5}, "name": {"const": "idrSlice"}}},
          {"properties": {"value": {"const": 6}, "name": {"const": "sei"}}},
          {"properties": {"value": {"const": 7}, "name": {"const": "sequenceParameterSet"}}},
          {"properties": {"value": {"const": 8}, "name": {"const": "pictureParameterSet"}}},
          {"properties": {"value": {"const": 9}, "name": {"const": "accessUnitDelimiter"}}},
          {"properties": {"value": {"const": 10}, "name": {"const": "endOfSequence"}}},
          {"properties": {"value": {"const": 11}, "name": {"const": "endOfStream"}}},
          {"properties": {"value": {"const": 12}, "name": {"const": "fillerData"}}},
          {"properties": {"value": {"const": 13}, "name": {"const": "sequenceParameterSetExtension"}}},
          {"properties": {"value": {"const": 14}, "name": {"const": "prefix"}}},
          {"properties": {"value": {"const": 15}, "name": {"const": "subsetSequenceParameterSet"}}},
          {"properties": {"value": {"const": 16}, "name": {"const": "depthParameterSet"}}},
          {"properties": {"value": {"enum": [17, 18]}, "name": {"const": "reserved"}}},
          {"properties": {"value": {"const": 19}, "name": {"const": "auxiliaryCodedSlice"}}},
          {"properties": {"value": {"const": 20}, "name": {"const": "codedSliceExtension"}}},
          {"properties": {"value": {"const": 21}, "name": {"const": "depthViewCodedSliceExtension"}}},
          {"properties": {"value": {"enum": [22, 23]}, "name": {"const": "reserved"}}},
          {"properties": {"value": {"minimum": 24, "maximum": 31}, "name": {"const": "unspecified"}}}
        ]}
      ]
    },
    "unsignedField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "span"],
      "properties": {"value": {"$ref": "#/$defs/uint64"}, "span": {"$ref": "#/$defs/span"}}
    },
    "uint8Field": {
      "allOf": [{"$ref": "#/$defs/unsignedField"}, {"properties": {"value": {"maximum": 255}}}]
    },
    "sixBitField": {
      "allOf": [{"$ref": "#/$defs/unsignedField"}, {"properties": {"value": {"maximum": 63}}}]
    },
    "fiveBitField": {
      "allOf": [{"$ref": "#/$defs/unsignedField"}, {"properties": {"value": {"maximum": 31}}}]
    },
    "threeBitField": {
      "allOf": [{"$ref": "#/$defs/unsignedField"}, {"properties": {"value": {"maximum": 7}}}]
    },
    "twoBitField": {
      "allOf": [{"$ref": "#/$defs/unsignedField"}, {"properties": {"value": {"maximum": 3}}}]
    },
    "booleanField": {
      "type": "object",
