      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chromaFormatIdc": {"$ref": "#/$defs/mappedUnsignedField"},
        "separateColourPlaneFlag": {"$ref": "#/$defs/mappedBooleanField"},
        "bitDepthLumaMinus8": {"$ref": "#/$defs/mappedUnsignedField"},
        "bitDepthChromaMinus8": {"$ref": "#/$defs/mappedUnsignedField"},
        "qpPrimeYZeroTransformBypassFlag": {"$ref": "#/$defs/mappedBooleanField"},
        "sequenceScalingMatrixPresentFlag": {"$ref": "#/$defs/mappedBooleanField"}
      },
      "dependentRequired": {
        "bitDepthLumaMinus8": ["chromaFormatIdc"],
        "bitDepthChromaMinus8": ["chromaFormatIdc", "bitDepthLumaMinus8"],
        "qpPrimeYZeroTransformBypassFlag": ["chromaFormatIdc", "bitDepthLumaMinus8", "bitDepthChromaMinus8"],
        "sequenceScalingMatrixPresentFlag": ["chromaFormatIdc", "bitDepthLumaMinus8", "bitDepthChromaMinus8", "qpPrimeYZeroTransformBypassFlag"]
      },
      "allOf": [
        {"if": {"required": ["separateColourPlaneFlag"]}, "then": {"required": ["chromaFormatIdc"], "properties": {"chromaFormatIdc": {"properties": {"value": {"const": 3}}, "required": ["value"]}}}},
        {"if": {"properties": {"chromaFormatIdc": {"properties": {"value": {"const": 3}}, "required": ["value"]}}, "required": ["chromaFormatIdc", "bitDepthLumaMinus8"]}, "then": {"required": ["separateColourPlaneFlag"]}}
      ]
    },
    "sequenceParameterSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rbsp", "syntaxBits", "remainingRbspBits", "complete"],
      "properties": {
        "rbsp": {"$ref": "#/$defs/rbspView"},
        "profileIdc": {"$ref": "#/$defs/mappedUnsignedField"},
        "constraintSetFlags": {"$ref": "#/$defs/mappedUnsignedField"},
        "reservedZero2Bits": {"$ref": "#/$defs/mappedUnsignedField"},
        "levelIdc": {"$ref": "#/$defs/mappedUnsignedField"},
        "sequenceParameterSetId": {"$ref": "#/$defs/mappedUnsignedField"},
        "highProfile": {"$ref": "#/$defs/spsHighProfile"},
