        {"if": {"properties": {"frameCroppingFlag": {"properties": {"value": {"const": false}}, "required": ["value"]}}, "required": ["frameCroppingFlag"]}, "then": {"not": {"anyOf": [{"required": ["frameCropLeftOffset"]}, {"required": ["frameCropRightOffset"]}, {"required": ["frameCropTopOffset"]}, {"required": ["frameCropBottomOffset"]}]}}},
