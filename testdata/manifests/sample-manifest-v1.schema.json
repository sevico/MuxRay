{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sample-manifest-v1.schema.json",
  "title": "MuxRay sample manifest v1",
  "description": "Path-safe metadata and minimum expectations for one exact FLV test artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "id",
    "description",
    "format",
    "originClass",
    "validity",
    "storage",
    "file",
    "provenance",
    "rights",
    "privacy",
    "features",
    "expected"
  ],
  "properties": {
    "manifestVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 96
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "format": {
      "const": "flv"
    },
    "originClass": {
      "enum": [
        "real",
        "generated",
        "derived"
      ]
    },
    "validity": {
      "enum": [
        "valid",
        "damaged",
        "edge-case"
      ]
    },
    "storage": {
      "enum": [
        "repository",
        "metadata-only",
        "not-collected"
      ]
    },
    "file": {
      "$ref": "#/$defs/file"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "rights": {
      "$ref": "#/$defs/rights"
    },
    "privacy": {
      "$ref": "#/$defs/privacy"
    },
    "features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "minLength": 2,
        "maxLength": 64
      }
    },
    "expected": {
      "$ref": "#/$defs/expected"
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "storage": {
            "const": "repository"
          }
        },
        "required": [
          "storage"
        ]
      },
      "then": {
        "properties": {
          "rights": {
            "properties": {
              "redistribution": {
                "const": "approved-for-repository"
              }
            },
            "required": [
              "redistribution"
            ]
          },
          "privacy": {
            "properties": {
              "reviewStatus": {
                "enum": [
                  "no-sensitive-data",
                  "sanitized"
                ]
              }
            },
            "required": [
              "reviewStatus"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "uint64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byteOffset",
        "bitOffset",
        "bitLength"
      ],
      "properties": {
        "byteOffset": {
          "$ref": "#/$defs/uint64"
        },
        "bitOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "bitLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sizeBytes",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[^/\\\\]+$",
          "minLength": 1,
          "maxLength": 255,
          "description": "A basename only, never an absolute or relative path."
        },
        "sizeBytes": {
          "$ref": "#/$defs/uint64"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "sourceReference"
      ],
      "properties": {
        "method": {
          "enum": [
            "generated",
            "captured",
            "downloaded",
            "submitted",
            "derived",
            "unknown"
          ]
        },
        "sourceReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "A public citation, generator description, or opaque internal evidence ID without credentials or local paths."
        },
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "recipe"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "recipe": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "redistribution"
      ],
      "properties": {
        "redistribution": {
          "enum": [
            "approved-for-repository",
            "testing-only",
            "prohibited",
            "unreviewed"
          ]
        },
        "licenseExpression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "License for the sample bytes, preferably SPDX; it is not the MuxRay project license."
        },
        "evidenceReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Public citation or opaque review/evidence ID; do not place confidential evidence here."
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewStatus"
      ],
      "properties": {
        "reviewStatus": {
          "enum": [
            "no-sensitive-data",
            "sanitized",
            "sensitive",
            "not-reviewed"
          ]
        },
        "evidenceReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "expectedHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "typeFlags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "hasAudio": {
          "type": "boolean"
        },
        "hasVideo": {
          "type": "boolean"
        },
        "dataOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "previousTagSize0": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "expectedDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "count"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "severity": {
          "enum": [
            "warning",
            "error"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "firstAnchor": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reportSchemaVersion",
        "scanComplete",
        "header",
        "tagCount",
        "diagnostics"
      ],
      "properties": {
        "reportSchemaVersion": {
          "const": 1
        },
        "scanComplete": {
          "type": "boolean"
        },
        "header": {
          "$ref": "#/$defs/expectedHeader"
        },
        "tagCount": {
          "type": "integer",
          "minimum": 0
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expectedDiagnostic"
          }
        },
        "goldenReport": {
          "type": "string",
          "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+\\.json$",
          "maxLength": 500,
          "description": "Optional repository-relative path; absolute and parent-traversal paths are forbidden."
        }
      }
    }
  }
}
